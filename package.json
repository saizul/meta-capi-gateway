{
  "name": "meta-capi-gateway",
  "version": "0.1.0",
  "description": "Self-hostable Meta Conversions API gateway: validates, normalizes, hashes, batches and forwards browser and WooCommerce events.",
  "type": "module",
  "license": "MIT",
  "author": "Saizul Amin <https://saizul.com>",
  "homepage": "https://saizul.com",
  "keywords": [
    "meta",
    "facebook",
    "conversions-api",
    "capi",
    "pixel",
    "woocommerce",
    "tracking"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "capi-replay": "dist/cli-replay.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "replay": "node dist/cli-replay.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
