# Required
PIXEL_ID=000000000000000
ACCESS_TOKEN=replace-with-your-conversions-api-access-token

# Optional: send to the Test Events tab (remove in production)
# TEST_EVENT_CODE=TEST12345

PORT=8080
HOST=0.0.0.0
GRAPH_API_VERSION=v23.0
ALLOWED_ORIGINS=https://www.example.com,https://*.example.com
ALLOW_MISSING_ORIGIN=false
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
# Number of reverse proxies in front (reads X-Forwarded-For from the right). 0 = use socket address
TRUST_PROXY_HOPS=0
BATCH_SIZE=50
BATCH_INTERVAL_MS=2000
MAX_QUEUE=10000
MAX_RETRIES=4
DEAD_LETTER_PATH=./data/dead-letter.jsonl
DEFAULT_PHONE_COUNTRY_CODE=880
LOG_LEVEL=info

# WooCommerce (leave empty to disable /webhooks/woocommerce)
WOOCOMMERCE_WEBHOOK_SECRET=

# Shopify (leave empty to disable /webhooks/shopify)
SHOPIFY_WEBHOOK_SECRET=
# financial_status values sent as Purchase; add "pending" for cash-on-delivery stores
SHOPIFY_FINANCIAL_STATUSES=paid
SHOPIFY_INCLUDE_TEST_ORDERS=false

# Used as event_source_url for WooCommerce and Shopify orders
SITE_URL=https://shop.example.com
